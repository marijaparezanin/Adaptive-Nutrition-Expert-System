package rules;

import java.time.LocalDateTime;
import java.time.LocalDate;

import com.ftn.sbnz.model.enums.AnalyticStatusType;
import com.ftn.sbnz.model.enums.DailyIntakeStatus;
import com.ftn.sbnz.model.enums.GoalType;
import com.ftn.sbnz.model.enums.MealCategory;
import com.ftn.sbnz.model.enums.SeverityLevel;
import com.ftn.sbnz.model.enums.WeightTrend;
import com.ftn.sbnz.model.events.MealSkipped;
import com.ftn.sbnz.model.events.NewActivityRoutine;
import com.ftn.sbnz.model.events.WeightMeasured;
import com.ftn.sbnz.model.models.AnalyticStatus;
import com.ftn.sbnz.model.models.BingePattern;
import com.ftn.sbnz.model.models.BreakfastSkippingPattern;
import com.ftn.sbnz.model.models.ConsistentProteinDeficit;
import com.ftn.sbnz.model.models.DailyIntake;
import com.ftn.sbnz.model.models.LateNightEatingPattern;
import com.ftn.sbnz.model.models.LongFastDetected;
import com.ftn.sbnz.model.models.Meal;
import com.ftn.sbnz.model.models.MissedMealAlert;
import com.ftn.sbnz.model.models.Recommendation;
import com.ftn.sbnz.model.models.RuleTemplateParameter;
import com.ftn.sbnz.model.models.UnplannedSnackingPattern;
import com.ftn.sbnz.model.models.User;
import com.ftn.sbnz.model.models.WeeklyPattern;
import com.ftn.sbnz.model.models.WeightStagnationDetected;

// ─────────────────────────────────────────────────────────────────────────────
// TIER 0 - INITIALIZATION (salience 100-95)
// ─────────────────────────────────────────────────────────────────────────────

rule "Initialize user target values"
salience 100
when
    $user : User(targetCalories == 0 || targetProtein == 0 || bmr == 0)
then
    modify($user) {
        initializeTargets()
    }
end

rule "Apply New Activity Routine"
salience 95
no-loop true
when
    $activity : NewActivityRoutine($userId : userId, $factor : activityFactor)
    $user : User(id == $userId)
then
    modify($user) {
        setActivityFactor($factor),
        initializeTargets()
    }
end

// ─────────────────────────────────────────────────────────────────────────────
// TIER 1 - MEAL PROCESSING (salience 90)
// ─────────────────────────────────────────────────────────────────────────────

// NOTE: DailyIntake arrives pre-aggregated from the frontend (totalCalories/totalProtein/totalFiber
// already set). We do NOT re-aggregate here - that would double-count. Individual Meal facts are
// inserted solely for CEP pattern detection (late-night check, binge cluster, long fast, etc.).

// ─────────────────────────────────────────────────────────────────────────────
// TIER 2 - SINGLE-MEAL SIGNALS
// ─────────────────────────────────────────────────────────────────────────────

rule "Rule Low Protein Meal"
when
    $meal : Meal($userId : userId, protein < 15)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.LOW_PROTEIN_MEAL)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.LOW_PROTEIN_MEAL,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
end

rule "Rule Protein Warning"
when
    $meal : Meal($userId : userId, protein < 10)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.PROTEIN_WARNING)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.PROTEIN_WARNING,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "LOW_PROTEIN_MEAL",
        "A meal contains less than 10g protein. Add eggs, meat, fish, dairy or another protein source.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "CEP Calorie Spike Detected"
when
    $user : User($userId : id, $target : targetCalories > 0)
    Meal(userId == $userId, calories > ($target * 0.50))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.CALORIE_SPIKE_DETECTED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.CALORIE_SPIKE_DETECTED,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "CALORIE_SPIKE",
        "One meal exceeds 50% of your daily calorie target. Plan remaining meals lighter with more protein and fiber.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "CEP Late Night Spike"
when
    $user : User($userId : id, $target : targetCalories > 0)
    Meal(userId == $userId, calories > ($target * 0.30), (timestamp.getHour() >= 22 || timestamp.getHour() < 6))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.CIRCADIAN_RHYTHM_DISRUPTION)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.CIRCADIAN_RHYTHM_DISRUPTION,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new LateNightEatingPattern($userId, LocalDate.now(), 1));
    insert(new Recommendation(
        "LATE_NIGHT_SPIKE",
        "A large meal was logged after 22:00. Eating heavily late disrupts circadian metabolic rhythm. Try finishing calories before 20:00.",
        $userId,
        LocalDateTime.now()
    ));
end

// ─────────────────────────────────────────────────────────────────────────────
// TIER 3 - DAILY INTAKE SIGNALS
// ─────────────────────────────────────────────────────────────────────────────

rule "Rule Protein Floor"
when
    $user : User($userId : id, $weight : weight)
    DailyIntake(userId == $userId, totalProtein > 0, totalProtein < ($weight * 0.8))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.PROTEIN_INSUFFICIENT)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.PROTEIN_INSUFFICIENT,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
end

rule "Rule High Protein Hydration"
when
    $user : User($userId : id, $weight : weight)
    DailyIntake(userId == $userId, totalProtein > ($weight * 2.2))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.HIGH_PROTEIN_HYDRATION_NEEDED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.HIGH_PROTEIN_HYDRATION_NEEDED,
        SeverityLevel.LOW,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "HIGH_PROTEIN_HYDRATION",
        "Protein intake exceeds 2.2g/kg. Increase water intake and spread protein across more meals.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Fiber Critically Low"
when
    $user : User($userId : id)
    DailyIntake(userId == $userId, totalFiber > 0, totalFiber < 10)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.FIBER_CRITICALLY_LOW)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.FIBER_CRITICALLY_LOW,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "FIBER_LOW",
        "Daily fiber is critically low (under 10g). Add vegetables, legumes or whole grains to each meal.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Weight Loss Conflict"
when
    $user : User($userId : id, goal == GoalType.WEIGHT_LOSS)
    DailyIntake(userId == $userId, status == DailyIntakeStatus.SURPLUS)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.CALORIC_SURPLUS_ACCUMULATION)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.CALORIC_SURPLUS_ACCUMULATION,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "WEIGHT_LOSS_CONFLICT",
        "Daily intake is above your weight-loss target. Reduce caloric load of remaining meals or increase activity.",
        $userId,
        LocalDateTime.now()
    ));
end

// Chain: Surplus + Spike → compound warning for weight-loss goal
rule "Rule Surplus With Spike Combo"
when
    $user : User($userId : id, goal == GoalType.WEIGHT_LOSS)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.CALORIC_SURPLUS_ACCUMULATION)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.CALORIE_SPIKE_DETECTED)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.SURPLUS_WITH_DEFICIT_GOAL)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.SURPLUS_WITH_DEFICIT_GOAL,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "SURPLUS_SPIKE_COMBO",
        "You are in caloric surplus AND had a calorie spike meal which is a compounding risk for weight loss. Reassess your meal plan for the rest of the day.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Mass Gain Conflict"
when
    $user : User($userId : id, goal == GoalType.MUSCLE_GAIN)
    DailyIntake(userId == $userId, status == DailyIntakeStatus.DEFICIT)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.EXTREME_CALORIC_RESTRICTION)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.EXTREME_CALORIC_RESTRICTION,
        SeverityLevel.CRITICAL,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "MASS_GAIN_CONFLICT",
        "Intake is too low for muscle gain. Add a protein-rich, energy-dense meal.",
        $userId,
        LocalDateTime.now()
    ));
end

// ─────────────────────────────────────────────────────────────────────────────
// TIER 4 - CEP PATTERN DETECTION
// ─────────────────────────────────────────────────────────────────────────────

// BingePattern: 3+ meals within a strict 90-minute FORWARD window from an anchor meal.
// Uses anchor → anchor+90min (not centred ±90min) to avoid false positives.
// Meals at 10:30, 14:20, 17:05, 22:35: no anchor has 3+ meals within its next 90 min → does NOT fire.
// Meals at 12:00, 12:40, 13:15: anchor 12:00 window 12:00-13:30 contains all three → FIRES.
rule "CEP Rapid Meal Cluster"
when
    $user : User($userId : id)
    $anchor : Meal(userId == $userId, $anchorTime : timestamp)
    Number(intValue >= 3) from accumulate(
        Meal(userId == $userId,
             timestamp.compareTo($anchorTime) >= 0,
             timestamp.compareTo($anchorTime.plusMinutes(90)) <= 0),
        count(1)
    )
    not BingePattern(userId == $userId)
then
    insert(new BingePattern($userId, LocalDate.now(), 3, 90));
end

rule "CEP Unplanned Snacking"
when
    $user : User($userId : id)
    Number(intValue > 3) from accumulate(
        Meal(userId == $userId, category == MealCategory.SNACK),
        count(1)
    )
    not UnplannedSnackingPattern(userId == $userId)
then
    insert(new UnplannedSnackingPattern($userId, LocalDate.now(), 4));
end

// LateNightEatingPattern from WeeklyPattern - the frontend pre-counts late meals across the week.
// The spec threshold is: 3+ late meals (22h-06h) in a 7-day window.
// We use WeeklyPattern.lateMealCount (pre-aggregated) to detect the weekly pattern.
rule "CEP Late Night Eating Weekly Pattern"
when
    $user : User($userId : id)
    WeeklyPattern(userId == $userId, $lateMealCount : lateMealCount >= 3)
    not LateNightEatingPattern(userId == $userId)
then
    insert(new LateNightEatingPattern($userId, LocalDate.now(), $lateMealCount));
end

// Chain: UnplannedSnacking + high calories → caloric risk signal
rule "Rule Snack Overload Caloric Risk"
when
    $user : User($userId : id, $target : targetCalories > 0)
    UnplannedSnackingPattern(userId == $userId)
    DailyIntake(userId == $userId, totalCalories > ($target * 0.80))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.SNACK_OVERLOAD_CALORIC_RISK)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.SNACK_OVERLOAD_CALORIC_RISK,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "SNACK_OVERLOAD",
        "Unplanned snacking has consumed over 80% of your daily calorie budget. Stop unplanned eating and stick to your next planned meal.",
        $userId,
        LocalDateTime.now()
    ));
end

// Long fast: gap > 6h between any two meals where both fall in active hours (07h-22h)
// $first must be before $second (timestamp.isBefore) and gap must exceed 6 hours.
rule "Rule Long Fast"
when
    $first : Meal(
        $userId : userId,
        $firstTime : timestamp,
        timestamp.getHour() >= 7,
        timestamp.getHour() <= 22
    )

    $second : Meal(
        userId == $userId,
        this != $first,
        $secondTime : timestamp,
        timestamp.isAfter($firstTime.plusHours(6)),
        timestamp.getHour() >= 7,
        timestamp.getHour() <= 22
    )

    not Meal(
        userId == $userId,
        this != $first,
        this != $second,
        timestamp.isAfter($firstTime),
        timestamp.isBefore($secondTime)
    )

    not LongFastDetected(userId == $userId)
then
    insert(new LongFastDetected($userId, LocalDate.now(), 6));
    insert(new AnalyticStatus(
        AnalyticStatusType.LONG_FAST_DETECTED,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "LONG_FAST",
        "A gap of over 6 hours between meals was detected during active hours (07:00-22:00). Prolonged fasting raises cortisol and triggers rebound hunger. Plan a protein-rich snack to bridge the gap.",
        $userId,
        LocalDateTime.now()
    ));
end

// CEP Missed Meal - frontend inserts MissedMealAlert facts when "End Day" is pressed
rule "CEP Missed Breakfast Detected"
when
    $user : User($userId : id)
    MissedMealAlert(userId == $userId, missedCategory == "BREAKFAST")
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.MISSED_MEAL_DETECTED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.MISSED_MEAL_DETECTED,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "MISSED_BREAKFAST",
        "No breakfast was logged today. Skipping breakfast raises cortisol and tends to drive compensatory overeating later in the day.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "CEP Missed Lunch Detected"
when
    $user : User($userId : id)
    MissedMealAlert(userId == $userId, missedCategory == "LUNCH")
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.MISSED_MEAL_DETECTED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.MISSED_MEAL_DETECTED,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "MISSED_LUNCH",
        "No lunch was logged today. Skipping midday meals often leads to energy crashes and evening overeating.",
        $userId,
        LocalDateTime.now()
    ));
end

// Chain: LongFast + MissedMeal → elevated Energy Shortage
rule "Rule Long Fast Plus Missed Meal Chains to Energy Shortage"
when
    $user : User($userId : id)
    LongFastDetected(userId == $userId)
    MissedMealAlert(userId == $userId)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.ENERGY_SHORTAGE)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.ENERGY_SHORTAGE,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "FAST_PLUS_MISSED_MEAL",
        "Both a long fasting gap AND a skipped meal were detected. Your body is in an energy shortage. Eat a balanced meal with protein and complex carbs now.",
        $userId,
        LocalDateTime.now()
    ));
end

// Replaces Template_BreakfastSkippingPattern (moved out of template engine to avoid CSV parsing issues).
// Fires when 3+ MealSkipped(BREAKFAST) facts are in working memory across the week.
rule "Template_BreakfastSkippingPattern"
when
    $user : User($userId : id)
    Number(intValue >= 3) from accumulate(
        MealSkipped(userId == $userId, category == MealCategory.BREAKFAST),
        count(1)
    )
    not BreakfastSkippingPattern(userId == $userId)
then
    insert(new BreakfastSkippingPattern($userId, LocalDate.now(), 3));
end

// Single MealSkipped(BREAKFAST) → ENERGY_SHORTAGE (today's signal, before weekly pattern fires)
rule "CEP Today Breakfast Skipped"
when
    $user : User($userId : id)
    MealSkipped(userId == $userId, category == MealCategory.BREAKFAST)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.ENERGY_SHORTAGE)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.ENERGY_SHORTAGE,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "BREAKFAST_SKIPPED_TODAY",
        "No breakfast was logged today. Skipping breakfast elevates cortisol and drives compensatory overeating later - typically 20-30% more calories at subsequent meals.",
        $userId,
        LocalDateTime.now()
    ));
end

// ─────────────────────────────────────────────────────────────────────────────
// TIER 5 - MULTI-DAY / PATTERN SIGNALS
// ─────────────────────────────────────────────────────────────────────────────

rule "Rule Weight Loss Activity Recommendation"
when
    $user : User($userId : id, goal == GoalType.WEIGHT_LOSS, $target : targetCalories > 0)
    WeeklyPattern(userId == $userId, averageCalories >= $target)
    not Recommendation(userId == $userId, type == "ACTIVITY_INCREASE")
then
    insert(new Recommendation(
        "ACTIVITY_INCREASE",
        "Goal is weight loss but weekly average shows no caloric deficit. Increase activity or reduce intake for the coming period.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Weight Oscillation"
when
    $first : WeightMeasured($userId : userId, $firstWeight : weight, $firstTime : timestamp)
    WeightMeasured(userId == $userId, Math.abs(weight - $firstWeight) > 2.0,
                   timestamp.isAfter($firstTime), timestamp.isBefore($firstTime.plusDays(8)))
    not Recommendation(userId == $userId, type == "WEIGHT_OSCILLATION")
then
    insert(new Recommendation(
        "WEIGHT_OSCILLATION",
        "Weight oscillated more than 2kg in one week. Check hydration, sodium intake and consistency of measurement timing.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Protein Distribution Conflict"
when
    $meal : Meal($userId : userId, protein < 15)
    Number(intValue >= 4) from accumulate(
        Meal(userId == $userId, protein < 15),
        count(1)
    )
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.PROTEIN_DISTRIBUTION_CONFLICT)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.PROTEIN_DISTRIBUTION_CONFLICT,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(3),
        $userId
    ));
    insert(new Recommendation(
        "PROTEIN_DISTRIBUTION",
        "4 or more meals have been low in protein. Spread intake evenly - every meal should hit at least 20g.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Energy Shortage Link from Breakfast Skipping Pattern"
when
    $pattern : BreakfastSkippingPattern($userId : userId)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.ENERGY_SHORTAGE)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.ENERGY_SHORTAGE,
        SeverityLevel.WARNING,
        LocalDateTime.now().plusDays(2),
        $userId
    ));
    insert(new Recommendation(
        "BREAKFAST_SKIPPING",
        "Breakfast skipping detected at least 3 times. Introduce a morning meal of ~250 kcal before 09:00.",
        $userId,
        LocalDateTime.now()
    ));
end

// Chain: Energy Shortage + large meal → Overeating
rule "Rule Pattern Linkage Overtaking"
when
    $user : User($userId : id, $target : targetCalories > 0)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.ENERGY_SHORTAGE)
    Meal(userId == $userId, calories > ($target * 0.40))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.OVEREATING_DETECTED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.OVEREATING_DETECTED,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "BINGE_WARNING",
        "Meal skipping has been linked to a large compensatory meal. Distribute energy more evenly through the day.",
        $userId,
        LocalDateTime.now()
    ));
end

// Chain: Overeating + Fiber Low → quality deficit escalation
rule "Rule Overeating Plus Fiber Low Escalation"
when
    AnalyticStatus($userId : userId, type == AnalyticStatusType.OVEREATING_DETECTED)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.FIBER_CRITICALLY_LOW)
    not Recommendation(userId == $userId, type == "QUALITY_DEFICIT")
then
    insert(new Recommendation(
        "QUALITY_DEFICIT",
        "Overeating AND critically low fiber - a pattern of high-calorie, low-nutrient eating. Prioritize vegetables, legumes and whole grains at your next meal.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Late Night Pattern Recommendation"
when
    LateNightEatingPattern($userId : userId, lateMealCount >= 3)
    not Recommendation(userId == $userId, type == "LATE_NIGHT_EATING_PATTERN")
then
    insert(new Recommendation(
        "LATE_NIGHT_EATING_PATTERN",
        "At least 3 late-night meals detected. Move dinner earlier and reduce late-evening caloric load.",
        $userId,
        LocalDateTime.now()
    ));
end

// Chain: LateNight + LongFast → compound circadian warning
rule "Rule Late Night Plus Long Fast Compound Risk"
when
    LateNightEatingPattern($userId : userId)
    LongFastDetected(userId == $userId)
    not Recommendation(userId == $userId, type == "CIRCADIAN_FAST_COMBO")
then
    insert(new Recommendation(
        "CIRCADIAN_FAST_COMBO",
        "Pattern: long daytime fast followed by late-night eating. This circadian mismatch suppresses fat metabolism. Eat more earlier in the day and stop by 20:00.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Binge Pattern Recommendation"
when
    BingePattern($userId : userId)
    not Recommendation(userId == $userId, type == "BINGE_PATTERN")
then
    insert(new Recommendation(
        "BINGE_PATTERN",
        "3 meals detected within a 90-minute window - rapid meal clustering. Wait at least 2 hours between meals and let hunger signals reset.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "Rule Caloric Surplus Accumulation From Snacks"
when
    $user : User($userId : id, $target : targetCalories > 0)
    UnplannedSnackingPattern(userId == $userId)
    DailyIntake(userId == $userId, totalCalories > $target)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.CALORIC_SURPLUS_ACCUMULATION)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.CALORIC_SURPLUS_ACCUMULATION,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
end

rule "CEP Consistent Protein Deficit"
when
    $user : User($userId : id, $proteinTarget : targetProtein > 0)
    Number(intValue >= 5) from accumulate(
        DailyIntake(userId == $userId, totalProtein < ($proteinTarget * 0.70), totalProtein > 0),
        count(1)
    )
    not ConsistentProteinDeficit(userId == $userId)
then
    insert(new ConsistentProteinDeficit($userId, LocalDate.now(), 5));
end

rule "Rule Muscle Loss Risk"
when
    $deficit : ConsistentProteinDeficit($userId : userId)
    WeeklyPattern(userId == $userId, weightTrend == WeightTrend.NEGATIVE)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.MUSCLE_LOSS_RISK)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.MUSCLE_LOSS_RISK,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(3),
        $userId
    ));
end

// Chain: MuscleLossRisk + LowProteinMeal → ProteinCritical
rule "Rule Protein Critical"
when
    AnalyticStatus($userId : userId, type == AnalyticStatusType.MUSCLE_LOSS_RISK)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.LOW_PROTEIN_MEAL)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.PROTEIN_CRITICAL)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.PROTEIN_CRITICAL,
        SeverityLevel.CRITICAL,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "PROTEIN_CRITICAL",
        "Protein is chronically below target alongside a negative weight trend. Muscle loss risk is high - immediately increase daily protein to at least 1.6g/kg.",
        $userId,
        LocalDateTime.now()
    ));
end

// Chain: ProteinCritical + FiberLow → compound nutrition failure
rule "Rule Protein Critical Plus Fiber Low"
when
    AnalyticStatus($userId : userId, type == AnalyticStatusType.PROTEIN_CRITICAL)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.FIBER_CRITICALLY_LOW)
    not Recommendation(userId == $userId, type == "COMPOUND_NUTRITION_FAILURE")
then
    insert(new Recommendation(
        "COMPOUND_NUTRITION_FAILURE",
        "CRITICAL: Both protein and fiber are critically low simultaneously. Your diet is nutritionally inadequate - restructure your meal plan and consider consulting a nutrition professional.",
        $userId,
        LocalDateTime.now()
    ));
end

rule "CEP Weight Stagnation"
when
    $pattern : WeeklyPattern($userId : userId, weightVarianceKg > 0, weightVarianceKg < 0.2)
    not WeightStagnationDetected(userId == $userId)
then
    insert(new WeightStagnationDetected($userId, LocalDate.now(), $pattern.getWeightVarianceKg()));
end

rule "Rule Weight Stagnation Confirmation"
when
    $user : User($userId : id, $target : targetCalories > 0)
    WeightStagnationDetected(userId == $userId)
    WeeklyPattern(userId == $userId, averageCalories < $target)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.WEIGHT_STAGNATION_CONFIRMED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.WEIGHT_STAGNATION_CONFIRMED,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(7),
        $userId
    ));
end

rule "Rule Extreme Caloric Restriction"
when
    $user : User($userId : id, $bmr : bmr > 0)
    WeeklyPattern(userId == $userId, averageCalories < ($bmr * 0.50))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.EXTREME_CALORIC_RESTRICTION)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.EXTREME_CALORIC_RESTRICTION,
        SeverityLevel.CRITICAL,
        LocalDateTime.now().plusDays(3),
        $userId
    ));
end

// Chain: StagnationConfirmed + ExtremeRestriction → CaloricAdaptationBlock
rule "Rule Caloric Adaptation Block"
when
    $user : User($userId : id, $bmr : bmr > 0)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.WEIGHT_STAGNATION_CONFIRMED)
    WeeklyPattern(userId == $userId, averageCalories < ($bmr * 0.50))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.CALORIC_ADAPTATION_BLOCK)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.CALORIC_ADAPTATION_BLOCK,
        SeverityLevel.CRITICAL,
        LocalDateTime.now().plusDays(7),
        $userId
    ));
end

// Chain: CaloricAdaptation or ExtremeRestriction → PlanChangeNeeded
rule "Rule Plan Change Needed"
when
    AnalyticStatus($userId : userId,
        type in (AnalyticStatusType.CALORIC_ADAPTATION_BLOCK, AnalyticStatusType.EXTREME_CALORIC_RESTRICTION))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.PLAN_CHANGE_NEEDED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.PLAN_CHANGE_NEEDED,
        SeverityLevel.CRITICAL,
        LocalDateTime.now().plusDays(7),
        $userId
    ));
    insert(new Recommendation(
        "PLAN_CHANGE_NEEDED",
        "Your plan requires recalibration: weight stagnation or extreme caloric restriction is present. Consider a structured diet break or refeed before continuing.",
        $userId,
        LocalDateTime.now()
    ));
end

// ─────────────────────────────────────────────────────────────────────────────
// TIER 7 - COMPOUND PATTERN SYNTHESIS (spec Rule_Pattern_Linkage and variants)
// These rules fire AFTER lower-tier AnalyticStatus facts are already in working memory.
// Forward chaining: Tier2/3/5 facts → Tier7 compound conclusions.
// ─────────────────────────────────────────────────────────────────────────────

// Spec: BreakfastSkipping + LateNightEating + weight not moving → linked pattern stagnation risk.
// WeightStagnationDetected fires when weightVarianceKg > 0 && < 0.2 (weight barely moving).
// This pattern explains WHY weight stagnates: the breakfast→late-night cycle keeps total intake above target.
rule "Rule Pattern Linkage Stagnation Risk"
when
    BreakfastSkippingPattern($userId : userId)
    LateNightEatingPattern(userId == $userId)
    WeightStagnationDetected(userId == $userId)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.LINKED_PATTERN_STAGNATION_RISK)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.LINKED_PATTERN_STAGNATION_RISK,
        SeverityLevel.CRITICAL,
        LocalDateTime.now().plusDays(7),
        $userId
    ));
    insert(new Recommendation(
        "LINKED_PATTERN_STAGNATION",
        "Compound pattern detected: breakfast skipping + late-night eating + weight stagnation. " +
        "These three patterns reinforce each other - morning restriction shifts your caloric load to the evening, " +
        "disrupting circadian metabolism and halting weight loss. Break the cycle: eat within 1 hour of waking.",
        $userId,
        LocalDateTime.now()
    ));
end

// Spec: ConsistentProteinDeficit across week → weekly protein deficit signal
rule "Rule Weekly Protein Deficit"
when
    $user : User($userId : id, $weight : weight > 0, $proteinTarget : targetProtein > 0)
    ConsistentProteinDeficit(userId == $userId)
    WeeklyPattern(userId == $userId, proteinTrend < ($proteinTarget * 0.80))
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.WEEKLY_PROTEIN_DEFICIT)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.WEEKLY_PROTEIN_DEFICIT,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(3),
        $userId
    ));
    insert(new Recommendation(
        "WEEKLY_PROTEIN_DEFICIT",
        "Protein intake has been consistently below 80% of target for the entire week. " +
        "At this level, muscle synthesis is compromised regardless of training. " +
        "Add a high-protein food (eggs, chicken breast, Greek yogurt, cottage cheese) to each meal.",
        $userId,
        LocalDateTime.now()
    ));
end

// Spec: EnergyShortage + LateNightEating → reactive eating confirmed
rule "Rule Reactive Eating Confirmed"
when
    AnalyticStatus($userId : userId, type == AnalyticStatusType.ENERGY_SHORTAGE)
    LateNightEatingPattern(userId == $userId)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.CIRCADIAN_RHYTHM_DISRUPTION)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.REACTIVE_EATING_CONFIRMED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.REACTIVE_EATING_CONFIRMED,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(2),
        $userId
    ));
    insert(new Recommendation(
        "REACTIVE_EATING_SYNTHESIS",
        "Reactive eating confirmed: daytime energy restriction is directly driving late-night overeating. " +
        "This is not a willpower issue - your hunger hormones (ghrelin) peak after prolonged restriction. " +
        "Eat a balanced 400-500 kcal meal before 12:00 to reset your appetite rhythm.",
        $userId,
        LocalDateTime.now()
    ));
end

// Spec: Caloric surplus + weight loss goal → goal conflict activity signal
rule "Rule Goal Conflict Activity Needed"
when
    $user : User($userId : id, goal == GoalType.WEIGHT_LOSS, $target : targetCalories > 0)
    DailyIntake(userId == $userId, totalCalories > ($target * 1.10))
    WeeklyPattern(userId == $userId, averageCalories >= $target)
    not AnalyticStatus(userId == $userId, type == AnalyticStatusType.GOAL_CONFLICT_ACTIVITY_NEEDED)
then
    insert(new AnalyticStatus(
        AnalyticStatusType.GOAL_CONFLICT_ACTIVITY_NEEDED,
        SeverityLevel.HIGH,
        LocalDateTime.now().plusDays(1),
        $userId
    ));
    insert(new Recommendation(
        "GOAL_CONFLICT_ACTIVITY",
        "Your weight-loss goal is being undermined by sustained caloric surplus. " +
        "Either reduce daily intake by 300-400 kcal, or add 30-45 minutes of moderate-intensity cardio to create the required deficit.",
        $userId,
        LocalDateTime.now()
    ));
end

// Compound: ProteinCritical + EnergyShortage → acute protein-energy co-deficiency
rule "Rule Compound Reactive Protein Energy"
when
    AnalyticStatus($userId : userId, type == AnalyticStatusType.PROTEIN_CRITICAL)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.ENERGY_SHORTAGE)
    not Recommendation(userId == $userId, type == "COMPOUND_REACTIVE_PROTEIN")
then
    insert(new Recommendation(
        "COMPOUND_REACTIVE_PROTEIN",
        "Acute compound risk: both protein and total energy are critically insufficient simultaneously. " +
        "The body will catabolise muscle to meet energy demands. Consume a protein-rich, calorie-adequate meal immediately.",
        $userId,
        LocalDateTime.now()
    ));
end

// Compound: LongFast + CircadianDisruption → fast-circadian metabolic combo
rule "Rule Fast Circadian Combo"
when
    LongFastDetected($userId : userId)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.CIRCADIAN_RHYTHM_DISRUPTION)
    not Recommendation(userId == $userId, type == "FAST_CIRCADIAN_COMBO")
then
    insert(new Recommendation(
        "FAST_CIRCADIAN_COMBO",
        "Prolonged daytime fasting combined with late-night eating creates a double circadian disruption. " +
        "This pattern suppresses leptin, elevates cortisol, and promotes fat storage - even without a caloric surplus. " +
        "Align eating with daylight hours: first meal before 09:00, last meal before 20:00.",
        $userId,
        LocalDateTime.now()
    ));
end

// ─────────────────────────────────────────────────────────────────────────────
// QUERIES
// ─────────────────────────────────────────────────────────────────────────────

query "whyOvereatingDetected"(Long $userId)
    BreakfastSkippingPattern(userId == $userId)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.ENERGY_SHORTAGE)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.OVEREATING_DETECTED)
end

query "whyProteinCritical"(Long $userId)
    ConsistentProteinDeficit(userId == $userId)
    WeeklyPattern(userId == $userId, weightTrend == WeightTrend.NEGATIVE)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.MUSCLE_LOSS_RISK)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.LOW_PROTEIN_MEAL)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.PROTEIN_CRITICAL)
end

query "whyPlanChangeNeeded"(Long $userId)
    WeightStagnationDetected(userId == $userId)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.WEIGHT_STAGNATION_CONFIRMED)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.CALORIC_ADAPTATION_BLOCK)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.PLAN_CHANGE_NEEDED)
end

query "whyLinkedPatternStagnation"(Long $userId)
    BreakfastSkippingPattern(userId == $userId)
    LateNightEatingPattern(userId == $userId)
    WeightStagnationDetected(userId == $userId)
    AnalyticStatus(userId == $userId, type == AnalyticStatusType.LINKED_PATTERN_STAGNATION_RISK)
end
