template header
ruleName
eventType
category
window
frequency
startHour
endHour
patternName

package rules.templates;

import java.time.LocalDate;
import java.time.LocalDateTime;

import com.ftn.sbnz.model.enums.MealCategory;
import com.ftn.sbnz.model.models.LateNightEatingPattern;
import com.ftn.sbnz.model.models.Meal;
import com.ftn.sbnz.model.models.MealSkipped;
import com.ftn.sbnz.model.models.User;

template "temporal pattern"

rule "@{ruleName}"
when
    $user : User($userId : id)
    Number(intValue >= @{frequency}) from accumulate(
        @{eventType}(userId == $userId),
        count(1)
    )
then
    // The generated form instantiates the configured CEP pattern object.
end

end template
