template header
ruleName
eventType
category
window
frequency
startHour
endHour
patternName
filterExpression
windowExpression
constructorArgs

package rules;

import java.time.LocalDate;

import com.ftn.sbnz.model.enums.MealCategory;
import com.ftn.sbnz.model.events.MealSkipped;
import com.ftn.sbnz.model.models.BingePattern;
import com.ftn.sbnz.model.models.BreakfastSkippingPattern;
import com.ftn.sbnz.model.models.LateNightEatingPattern;
import com.ftn.sbnz.model.models.Meal;
import com.ftn.sbnz.model.models.User;

template "temporal pattern"

rule "@{ruleName}"
when
    $user : User($userId : id)
    Number(intValue >= @{frequency}) from accumulate(
        @{eventType}(userId == $userId @{filterExpression}) @{windowExpression},
        count(1)
    )
    not @{patternName}(userId == $userId)
then
    insert(new @{patternName}($userId, LocalDate.now(), @{constructorArgs}));
end

end template
